# ─── Base de datos (COMPARTIDA con soytucanje/soyuadmin) ───
DATABASE_URL="postgresql://user:pass@host:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"

# ─── Supabase Auth (MISMO proyecto que soytucanje/soyuadmin) ───
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."
SUPABASE_JWT_SECRET="el-jwt-secret-del-proyecto"

# ─── URLs / subdominios ───
# En prod el root es soytuturno.com; en dev usar localhost (subdominios *.localhost).
ROOT_DOMAIN="soytuturno.com"
NEXT_PUBLIC_ROOT_DOMAIN="soytuturno.com"
# Puerto del web en dev (para armar links entre subdominios sobre localhost).
NEXT_PUBLIC_WEB_PORT=3200
NEXT_PUBLIC_API_URL="http://localhost:3201/v1"

# ─── DigitalOcean (auto-provisioning de subdominios por tenant) ───
# Si faltan, el provisioning queda DESHABILITADO (crear tenants sigue andando, sin dominios).
# Solo se setean en PRODUCCIÓN (en el env de la app de App Platform). En dev dejar vacías.
# Token: Personal Access Token con scopes domain:* y app:read+update.
DIGITALOCEAN_API_TOKEN=""
# ID de la app FE de soytuturno en App Platform.
DIGITALOCEAN_APP_ID=""
# Root DNS gestionado en DO (mismo valor que ROOT_DOMAIN).
DIGITALOCEAN_DOMAIN_ROOT="soytuturno.com"
# Hostname destino del CNAME: el default *.ondigitalocean.app de la app FE (sin el punto final).
DIGITALOCEAN_APP_TARGET="soy-tu-turno-fe-dej5t.ondigitalocean.app"

# ─── API ───
# Puertos propios (soytucanje usa 3000/3001; soyuadmin 3100/3101; soytuturno 3200/3201).
API_PORT=3201
WEB_ORIGIN="http://localhost:3200"
NODE_ENV="development"
