{
  "name": "soytuturno",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant appointment/booking SaaS for local businesses with WhatsApp-driven turnos",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @soytuturno/db generate",
    "db:migrate": "pnpm --filter @soytuturno/db migrate",
    "db:rls": "pnpm --filter @soytuturno/db migrate:rls",
    "db:push": "pnpm --filter @soytuturno/db push",
    "db:studio": "pnpm --filter @soytuturno/db studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
